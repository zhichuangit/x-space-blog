---
import { iconPaths } from './IconPaths';

interface Props {
	icon: string;
	size?: string;
	color?: string;
	gradient?: boolean;
}

const { icon, size = '1em', color = 'currentColor', gradient = false } = Astro.props;
const path = iconPaths[icon];
---

{
	gradient ? (
		<svg
			class="icon-gradient"
			width={size}
			height={size}
			viewBox="0 0 24 24"
			fill="none"
			stroke="url(#icon-gradient)"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
			focusable="false"
		>
			<defs>
				<linearGradient id="icon-gradient" x1="0" y1="0" x2="1" y2="1">
					<stop offset="0%" stop-color="hsl(199 89% 48%)" />
					<stop offset="100%" stop-color="hsl(173 80% 40%)" />
				</linearGradient>
			</defs>
			<path d={path} />
		</svg>
	) : (
		<svg
			width={size}
			height={size}
			viewBox="0 0 24 24"
			fill="none"
			stroke={color}
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
			focusable="false"
		>
			<path d={path} />
		</svg>
	)
}

<style>
	svg {
		display: inline-block;
		vertical-align: middle;
	}
</style>
