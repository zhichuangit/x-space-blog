---
import { baseUrl, SITE_TITLE } from '../consts';
import Icon from './Icon.astro';

const navLinks = [
	{ href: baseUrl, label: '首页' },
	{ href: `${baseUrl}blog`, label: '文章' },
	{ href: `${baseUrl}about`, label: '关于' },
	{ href: `${baseUrl}rss.xml`, label: 'RSS' },
];
---

<nav class="nav">
	<a href={baseUrl} class="nav-brand">
		<Icon icon="tag" size="1.4em" gradient={true} />
		<span>{SITE_TITLE}</span>
	</a>

	<div class="nav-links">
		{
			navLinks.map((link) => (
				<a href={link.href} class="nav-link">
					{link.label}
				</a>
			))
		}
	</div>
</nav>

<style>
	.nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-m);
		padding: var(--space-s) 0;
	}

	.nav-brand {
		display: inline-flex;
		align-items: center;
		gap: 0.5em;
		font-weight: 700;
		font-size: var(--text-lg);
		color: var(--text-strong);
	}

	.nav-brand:hover {
		text-decoration: none;
		color: var(--accent-text);
	}

	.nav-links {
		display: flex;
		align-items: center;
		gap: var(--space-s);
	}

	.nav-link {
		color: var(--text-soft);
		font-weight: 500;
		padding: 0.25em 0.5em;
		border-radius: var(--radius-sm);
		transition: color var(--theme-transition), background-color var(--theme-transition);
	}

	.nav-link:hover {
		color: var(--accent-text);
		background: hsl(var(--accent) / 0.08);
		text-decoration: none;
	}

	@media (max-width: 30em) {
		.nav-links {
			gap: var(--space-xs);
		}
		.nav-link {
			font-size: var(--text-sm);
		}
	}
</style>
