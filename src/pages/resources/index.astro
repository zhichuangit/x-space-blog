---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Icon from '../../components/Icon.astro';
import { baseUrl, SITE_TITLE } from '../../consts';

const resources = (await getCollection('resources')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// 分类徽章颜色映射
const categoryColors: Record<string, string> = {
	'开源项目': 'accent',
	'开源软件': 'accent',
	'大模型': 'accent',
	'其他': 'muted',
};
---

<BaseLayout title={`资源共享 | ${SITE_TITLE}`} description="开源项目、开源软件与大模型下载资源分享">
	<main class="wrapper">
		<header class="page-header stack gap-2">
			<h1>资源共享</h1>
			<p>共 {resources.length} 个资源 — 开源项目、开源软件与大模型下载。</p>
		</header>

		<ul class="resources">
			{
				resources.map((res, i) => (
					<li class="resource-item">
						<a href={`${baseUrl}resources/${res.id}/`} class="resource">
							<div class="meta">
								<span class="index">{String(i + 1).padStart(2, '0')}</span>
								<span
									class:list={[
										'category',
										`category-${categoryColors[res.data.category] ?? 'muted'}`,
									]}
								>
									{res.data.category}
								</span>
								<time datetime={res.data.pubDate.toISOString()}>
									<FormattedDate date={res.data.pubDate} />
								</time>
							</div>

							<h2 class="title">{res.data.title}</h2>
							<p class="excerpt">{res.data.description}</p>

							<div class="resource-meta">
								{res.data.version && (
									<span class="chip">
										<Icon icon="tag" size="0.9em" />
										{res.data.version}
									</span>
								)}
								{res.data.size && (
									<span class="chip">
										<Icon icon="download" size="0.9em" />
										{res.data.size}
									</span>
								)}
							</div>

							<span class="read-more">
								查看详情
								<Icon icon="arrow-right" size="1em" />
							</span>
						</a>
					</li>
				))
			}
		</ul>
	</main>
</BaseLayout>

<style>
	.page-header {
		margin-bottom: var(--space-xl);
	}

	.page-header h1 {
		font-size: var(--text-4xl);
	}

	.page-header p {
		color: var(--text-muted);
	}

	.resources {
		display: grid;
		gap: var(--space-m);
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.resource {
		display: grid;
		gap: var(--space-xs);
		padding: var(--space-l);
		border: 1px solid var(--card-border);
		border-radius: var(--radius-lg);
		background: var(--card);
		box-shadow: var(--shadow-sm);
		color: var(--text);
		transition: transform var(--theme-transition), box-shadow var(--theme-transition),
			border-color var(--theme-transition);
	}

	.resource:hover {
		text-decoration: none;
		transform: translateY(-3px);
		box-shadow: var(--shadow-md);
		border-color: hsl(var(--accent));
	}

	.meta {
		display: flex;
		align-items: center;
		gap: var(--space-s);
		margin-bottom: var(--space-2xs);
	}

	.index {
		font-family: var(--font-sans);
		font-size: var(--text-sm);
		font-weight: 700;
		letter-spacing: 0.05em;
		color: var(--accent-text);
		background: var(--accent-washed);
		border-radius: 999rem;
		padding: 0.1em 0.7em;
	}

	.category {
		font-size: var(--text-xs);
		font-weight: 600;
		padding: 0.2em 0.7em;
		border-radius: 999rem;
	}

	.category-accent {
		color: var(--accent-text);
		background: var(--accent-washed);
	}

	.category-muted {
		color: var(--text-muted);
		background: var(--gray-200);
	}

	.meta time {
		font-size: var(--text-sm);
		color: var(--text-muted);
	}

	.title {
		font-size: var(--text-2xl);
		line-height: 1.2;
	}

	.excerpt {
		color: var(--text-soft);
		font-size: var(--text-md);
		line-height: 1.6;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.resource-meta {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-xs);
		margin-top: var(--space-2xs);
	}

	.chip {
		display: inline-flex;
		align-items: center;
		gap: 0.35em;
		font-size: var(--text-xs);
		color: var(--text-muted);
		padding: 0.2em 0.7em;
		border: 1px solid var(--border);
		border-radius: 999rem;
	}

	.read-more {
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
		margin-top: var(--space-2xs);
		font-size: var(--text-sm);
		font-weight: 600;
		color: var(--accent-text);
	}

	.read-more :global(svg) {
		transition: transform var(--theme-transition);
	}

	.resource:hover .read-more :global(svg) {
		transform: translateX(3px);
	}

	@media (min-width: 50em) {
		.resources {
			grid-template-columns: repeat(2, 1fr);
			gap: var(--space-l);
		}
	}
</style>
