---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Icon from '../../components/Icon.astro';
import { baseUrl, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout title={`文章 | ${SITE_TITLE}`} description="所有博客文章">
	<main class="wrapper">
		<header class="page-header stack gap-2">
			<h1>文章</h1>
			<p>共 {posts.length} 篇 — 关于 AI 前沿与软件开发的思考。</p>
		</header>

		<ul class="posts">
			{
				posts.map((post, i) => (
					<li class="post-item">
						<a href={`${baseUrl}blog/${post.id}/`} class="post">
							{post.data.heroImage && (
								<div class="thumb">
									<Image width={720} height={360} src={post.data.heroImage} alt="" />
								</div>
							)}
							<div class="post-body">
								<div class="meta">
									<span class="index">{String(i + 1).padStart(2, '0')}</span>
									<time datetime={post.data.pubDate.toISOString()}>
										<FormattedDate date={post.data.pubDate} />
									</time>
								</div>
								<h2 class="title">{post.data.title}</h2>
								<p class="excerpt">{post.data.description}</p>
								<span class="read-more">
									阅读全文
									<Icon icon="arrow-right" size="1em" />
								</span>
							</div>
						</a>
					</li>
				))
			}
		</ul>
	</main>
</BaseLayout>

<style>
	.page-header {
		margin-bottom: var(--space-xl);
	}

	.page-header h1 {
		font-size: var(--text-4xl);
	}

	.page-header p {
		color: var(--text-muted);
	}

	.posts {
		display: grid;
		gap: var(--space-m);
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.post {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-m);
		padding: var(--space-l);
		border: 1px solid var(--card-border);
		border-radius: var(--radius-lg);
		background: var(--card);
		box-shadow: var(--shadow-sm);
		color: var(--text);
		transition: transform var(--theme-transition), box-shadow var(--theme-transition),
			border-color var(--theme-transition);
	}

	.post:hover {
		text-decoration: none;
		transform: translateY(-3px);
		box-shadow: var(--shadow-md);
		border-color: hsl(var(--accent));
	}

	/* 有封面图时，图文上下排布 */
	.post:has(.thumb) {
		grid-template-columns: 1fr;
	}

	@media (min-width: 50em) {
		/* 桌面端：无图卡片纵向排布，有图卡片图文分栏 */
		.post {
			grid-template-columns: 1fr;
		}
		.post:has(.thumb) {
			grid-template-columns: 14rem 1fr;
			align-items: center;
		}
	}

	.thumb {
		border-radius: var(--radius-md);
		overflow: hidden;
	}

	.thumb :global(img) {
		width: 100%;
		aspect-ratio: 2 / 1;
		object-fit: cover;
		display: block;
	}

	@media (min-width: 50em) {
		.post:has(.thumb) .thumb :global(img) {
			aspect-ratio: 1 / 1;
			height: 100%;
			object-fit: cover;
		}
	}

	.post-body {
		display: flex;
		flex-direction: column;
		gap: var(--space-xs);
	}

	.meta {
		display: flex;
		align-items: center;
		gap: var(--space-s);
		margin-bottom: var(--space-2xs);
	}

	.index {
		font-family: var(--font-sans);
		font-size: var(--text-sm);
		font-weight: 700;
		letter-spacing: 0.05em;
		color: var(--accent-text);
		background: var(--accent-washed);
		border-radius: 999rem;
		padding: 0.1em 0.7em;
	}

	.meta time {
		font-size: var(--text-sm);
		color: var(--text-muted);
	}

	.title {
		font-size: var(--text-2xl);
		line-height: 1.2;
	}

	.excerpt {
		color: var(--text-soft);
		font-size: var(--text-md);
		line-height: 1.6;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.read-more {
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
		margin-top: var(--space-2xs);
		font-size: var(--text-sm);
		font-weight: 600;
		color: var(--accent-text);
	}

	.read-more :global(svg) {
		transition: transform var(--theme-transition);
	}

	.post:hover .read-more :global(svg) {
		transform: translateX(3px);
	}
</style>
